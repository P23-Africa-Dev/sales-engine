  "narrative": {
    "northStar": "The inherited Sales Engine workspace",
    "overview": "The dashboard and approved social listening implementation establish this visual world. A textured deep teal canvas surrounds lifted white workspaces, with wine analytical surfaces and pale lavender supporting panels. Mint identifies actions and active navigation. CRM inherits that identity rather than establishing a separate palette.\n\nThe interface is compact, analytical, and suited to platform administrators managing client businesses. CRM uses local illustrative data; its management controls are demonstrations that reset on refresh. This document records the implemented system, not a promise of live service behavior.",
    "keyCharacteristics": [
      "White workspaces balanced with wine and lavender panels.",
      "Poppins typography and aligned tabular numerals.",
      "Rounded controls, soft structural elevation, and visible focus states.",
      "Scroll-triggered analytics with hover and keyboard inspection."
    ],
    "rules": [
      {
        "name": "The Balanced Workspace Rule",
        "body": "Preserve the observed mixture of white, wine, lavender, and teal; the user explicitly rejected an all-green surface.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve white workspaces, wine analysis, lavender support, and mint active states.",
      "Do keep client ownership visible and label analytical definitions.",
      "Do provide keyboard inspection alongside hover and respect reduced motion.",
      "Do preserve horizontal table scrolling on narrow screens."
    ],
    "donts": [
      "Don't fill the entire interface with green surfaces.",
      "Don't imply illustrative CRM values or local changes are live business results.",
      "Don't rely on chart color alone to convey source, stage, or value."
    ]
  }
