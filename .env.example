APP_NAME=SalesEngine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sales_engine
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@salesengine.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS — comma-separated origins for standalone SE + Factory23 frontends
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── GLM (Zhipu) ──────────────────────────────────────────────────────────────
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-4-flash
GLM_EXTRACT_MODEL=glm-4-flash
GLM_SCORE_MODEL=glm-4-air
GLM_OUTREACH_MODEL=glm-4-flash

# ── Discovery ────────────────────────────────────────────────────────────────
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
MONO_SECRET_KEY=
MONO_BASE_URL=https://api.withmono.com
FYLINGS_API_KEY=
FYLINGS_BASE_URL=https://api.fylings.com

# ── Factory23 bridge (shared HS256 secret with F23 SALES_ENGINE_JWT_SECRET) ─
FACTORY23_API_URL=http://127.0.0.1:8000
FACTORY23_JWT_SECRET=
# Optional server fallback token. CRM sync auto-bridges each org from the signed-in Factory23 user session.
FACTORY23_API_TOKEN=
# Optional JSON map of Factory23 company_id => Sanctum token for multi-tenant CRM push
FACTORY23_COMPANY_TOKENS=
FACTORY23_CRM_SYNC_ENABLED=false

# ── SendGrid (email outreach) ────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_PLATFORM_FROM_EMAIL=outreach@thefactory23.com
SENDGRID_WEBHOOK_SECRET=
SOCIAL_LISTENING_DAILY_API_CAP=200

# ── Optional stub adapters ───────────────────────────────────────────────────
APOLLO_API_KEY=
HUNTER_API_KEY=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sales-engine/1.0
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
